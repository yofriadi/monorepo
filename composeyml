services:
  rest:
    build:
      context: .
      dockerfile: apps/rest/Dockerfile
    ports:
      - "3002:3002"
    volumes:
      - ./packages/db:/app/node_modules/@workspace/db
      - ./packages/ui:/app/node_modules/@workspace/ui
    environment:
      - NODE_ENV=production
      - DATABASE_URL=postgresql://postgres:123456@postgres/postgres?sslmode=disable
      - REDIS_HOST=redis
      - REDIS_PORT=6379
    depends_on:
      - postgres
      - redis

  worker:
    build:
      context: .
      dockerfile: apps/worker/Dockerfile
    ports:
      - "3003:3003"
    volumes:
      - ./packages/db:/app/node_modules/@workspace/db
    environment:
      - NODE_ENV=production
      - DATABASE_URL=postgresql://postgres:123456@postgres/postgres?sslmode=disable
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - FIRECRAWL_API_KEY=fc-b6c2aebd4e4f48bd93017920864ba146
    depends_on:
      - postgres
      - redis

  dashboard:
    build:
      context: .
      dockerfile: apps/dashboard/Dockerfile
    ports:
      - "3001:3001"
    volumes:
      - ./packages/ui:/app/node_modules/@workspace/ui
    environment:
      - NODE_ENV=production
      - NEXT_PUBLIC_API_URL=http://rest:3002

  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: 123456
      POSTGRES_DB: scraping
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data

volumes:
  postgres_data:
  redis_data:
