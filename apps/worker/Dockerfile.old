# Base stage with Bun and pnpm
FROM oven/bun:alpine AS base
WORKDIR /app

# Install pnpm
RUN apk update && \
    apk add --no-cache npm && \
    npm install -g pnpm@latest

# Builder stage to prune the workspace
FROM base AS builder
ENV PNPM_HOME=/pnpm-global
ENV PATH=$PNPM_HOME:$PATH
RUN mkdir -p /root && touch /root/.shrc
ENV ENV=/root/.shrc
ENV SHELL=/bin/sh
# Enable corepack (which comes with Node 16.9+)
RUN corepack enable
# Run pnpm setup to create the global bin directory
RUN pnpm setup
RUN pnpm install turbo --global
COPY . .
RUN turbo prune worker --docker

# Installer stage to install dependencies and build
FROM base AS installer
WORKDIR /app

# Copy pruned package.json files, lockfile, and workspace config
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml .
COPY --from=builder /app/out/full/pnpm-workspace.yaml .

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Copy remaining source code
COPY --from=builder /app/out/full/ .

# Build project using Turborepo
RUN pnpm turbo run build --filter=worker...

# Runner stage
FROM oven/bun:alpine AS runner
WORKDIR /app

# Copy built application
COPY --from=installer /app/apps/worker/index .

# Environment variables
ENV NODE_ENV=production
ARG FIRECRAWL_API_KEY
ENV FIRECRAWL_API_KEY=$FIRECRAWL_API_KEY
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
ARG REDIS_HOST
ENV REDIS_HOST=$REDIS_HOST
ARG REDIS_PORT
ENV REDIS_PORT=$REDIS_PORT

EXPOSE 3003
CMD ["bun", "run", "./index"]
